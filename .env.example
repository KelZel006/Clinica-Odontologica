# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# NextAuth - Autenticación
NEXTAUTH_SECRET="genere_un_secreto_seguro_aqui"
AUTH_SECRET="genere_un_secreto_seguro_aqui"
# NEXTAUTH_URL se configura automáticamente en el entorno de despliegue

# Almacenamiento de archivos (AWS S3) - opcional
AWS_PROFILE=""
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""
