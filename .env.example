# Copiar a .env (y .env.local para Next.js) y completar. Nunca subir los archivos con valores reales.

# Supabase → Connect → Connection string (URI). Usado por el CLI de Supabase.
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Secreta: ignora RLS. Solo en servidor / n8n, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=""
